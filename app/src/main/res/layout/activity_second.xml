<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAEA"
    android:orientation="vertical"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="0dp">


        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/newtripborder"
            />




        <TextView
            android:id="@+id/build"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="50dp"
            android:fontFamily="@font/abril_fatface"
            android:gravity="center"
            android:text="Build a new trip"
            android:textColor="@color/white"
            android:textSize="34sp" />


        <TextView
            android:id="@+id/give"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:layout_marginLeft="120dp"

            android:text="Give us few details"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@+id/build"
            app:layout_constraintTop_toBottomOf="@+id/build" />

    </FrameLayout>

    <EditText
        android:id="@+id/duration"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/rounded_edit_text"
        android:padding="10dp"
        android:inputType="text"
        android:text="Duration"
        android:textColor="#D1A566"
        android:hint=""
        android:textColorHint="@color/black"/>

    <EditText
        android:id="@+id/date"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"

        android:background="@drawable/rounded_edit_text"
        android:inputType="text"
        android:text="Date"
        android:textColor="#D1A566"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/SaveBtn"
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:textColor="#d1a566"
        android:background="@drawable/submit_buttom"
        android:text="Save"

        android:layout_marginStart="140dp"
        android:layout_marginTop="30dp"
        android:textStyle="bold"
        android:textSize="20sp"
        />





    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginTop="170dp"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="120dp"
            android:textSize="20sp"
            android:gravity=""
            android:layout_weight="3"


            android:text="Get Ready Packages"
            android:textColor="#D1A566"/>

        <ImageButton
            android:id="@+id/goPackages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_weight="1"
            android:contentDescription="TODO"

            android:src="@drawable/goicon2"
            />

    </LinearLayout>




</LinearLayout>